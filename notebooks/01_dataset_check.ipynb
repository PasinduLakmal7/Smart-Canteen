{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 01. Dataset Check & Verification\n",
    "This notebook verifies the folder structure, labels, and statistics of the food detection dataset to ensure everything is set up correctly before training."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import yaml\n",
    "from pathlib import Path\n",
    "from dotenv import load_dotenv\n",
    "\n",
    "# Load environment variables from parent workspace\n",
    "load_dotenv(dotenv_path=\"../.env\")\n",
    "\n",
    "print(\"Environment loaded.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Configurations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load application paths\n",
    "config_path = Path(\"../configs/app_config.yaml\")\n",
    "with open(config_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    app_config = yaml.safe_load(f)\n",
    "\n",
    "dataset_dir = Path(\"..\") / app_config[\"paths\"][\"dataset_dir\"]\n",
    "data_yaml_path = dataset_dir / \"data.yaml\"\n",
    "\n",
    "print(f"Target Dataset Directory: {dataset_dir.resolve()}")\n",
    "print(f"Data YAML Path: {data_yaml_path.resolve()}")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Check Roboflow Dataset Download (Optional)\n",
    "If you haven't downloaded the dataset yet, you can run the code below to download it from Roboflow using your API key."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Uncomment and run this cell if you need to download the dataset programmatically\n",
    "\"\"\"\n",
    "from roboflow import Roboflow\n",
    "\n",
    "api_key = os.getenv(\"ROBOFLOW_API_KEY\")\n",
    "if api_key and api_key != \"your_roboflow_api_key_here\":\n",
    "    rf = Roboflow(api_key=api_key)\n",
    "    # Replace workspace and project with your Roboflow credentials if different\n",
    "    project = rf.workspace().project(\"string-hoppers-bptmw\")\n",
    "    dataset = project.version(1).download(\"yolov8\")\n",
    "    print(\"Dataset downloaded successfully!\")\n",
    "else:\n",
    "    print(\"Roboflow API key not set or invalid. Please check your .env file.\")\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Validate `data.yaml` content"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if data_yaml_path.exists():\n",
    "    with open(data_yaml_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        data_yaml = yaml.safe_load(f)\n",
    "    print(\"Successfully loaded data.yaml:\")\n",
    "    print(\"-\" * 40)\n",
    "    for key, value in data_yaml.items():\n",
    "        print(f\"{key}: {value}\")\n",
    "    print(\"-\" * 40)\n",
    "else:\n",
    "    print(f\"[ERROR] data.yaml not found at: {data_yaml_path.resolve()}\")\n",
    "    print(\"Please place your downloaded Roboflow dataset into the data/yolo_dataset folder.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Check Dataset Statistics (Image & Annotation counts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "splits = [\"train\", \"valid\", \"test\"]\n",
    "dataset_ok = True\n",
    "\n",
    "for split in splits:\n",
    "    split_dir = dataset_dir / split\n",
    "    img_dir = split_dir / \"images\"\n",
    "    lbl_dir = split_dir / \"labels\"\n",
    "    \n",
    "    print(f\"\\nChecking [{split.upper()}] split...\")\n",
    "    if not split_dir.exists():\n",
    "        print(f\"  [WARNING] Split folder does not exist: {split_dir}\")\n",
    "        dataset_ok = False\n",
    "        continue\n",
    "        \n",
    "    if not img_dir.exists() or not lbl_dir.exists():\n",
    "        print(f\"  [WARNING] 'images' or 'labels' subdirectory missing in {split_dir}\")\n",
    "        dataset_ok = False\n",
    "        continue\n",
    "        \n",
    "    images = list(img_dir.glob(\"*\"))\n",
    "    # Filter labels (ignore directories and keep only txt files)\n",
    "    labels = [f for f in lbl_dir.glob(\"*.txt\")]\n",
    "    \n",
    "    print(f\"  Images count: {len(images)}\")\n",
    "    print(f"  Labels count (annotations): {len(labels)}\")\n",
    "    \n",
    "    # Verify one-to-one mapping\n",
    "    img_stems = {f.stem for f in images}\n",
    "    lbl_stems = {f.stem for f in labels}\n",
    "    \n",
    "    unmatched_imgs = img_stems - lbl_stems\n",
    "    unmatched_lbls = lbl_stems - img_stems\n",
    "    \n",
    "    if unmatched_imgs:\n",
    "        print(f\"  [WARNING] {len(unmatched_imgs)} images do not have corresponding label files. (e.g. {list(unmatched_imgs)[:3]})\")\n",
    "    if unmatched_lbls:\n",
    "        print(f\"  [WARNING] {len(unmatched_lbls)} labels do not have corresponding image files. (e.g. {list(unmatched_lbls)[:3]})\")\n",
    "        dataset_ok = False\n",
    "        \n",
    "if dataset_ok:\n",
    "    print(\"\\n[SUCCESS] Dataset directory check passed successfully!\")\n",
    "else:\n",
    "    print(\"\\n[ERROR] Dataset has validation issues. Please fix them before training.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Visualize Annotated Samples"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def draw_bbox_and_show(img_path, lbl_path, class_names):\n",
    "    if not img_path.exists() or not lbl_path.exists():\n",
    "        print(f\"Could not find image or label: {img_path}, {lbl_path}\")\n",
    "        return\n",
    "        \n",
    "    img = cv2.imread(str(img_path))\n",
    "    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "    h, w, _ = img.shape\n",
    "    \n",
    "    with open(lbl_path, \"r\") as f:\n",
    "        lines = f.readlines()\n",
    "        \n",
    "    print(f\"Drawing annotations for: {img_path.name} (Boxes: {len(lines)})\")\n",
    "    for line in lines:\n",
    "        parts = line.strip().split()\n",
    "        if len(parts) == 5:\n",
    "            cls_id = int(parts[0])\n",
    "            x_c, y_c, box_w, box_h = map(float, parts[1:])\n",
    "            \n",
    "            # Denormalize\n",
    "            x1 = int((x_c - box_w / 2) * w)\n",
    "            y1 = int((y_c - box_h / 2) * h)\n",
    "            x2 = int((x_c + box_w / 2) * w)\n",
    "            y2 = int((y_c + box_h / 2) * h)\n",
    "            \n",
    "            cls_name = class_names[cls_id] if cls_id < len(class_names) else f\"Class {cls_id}\"\n",
    "            \n",
    "            # Draw bounding box and label\n",
    "            cv2.rectangle(img, (x1, y1), (x2, y2), (0, 255, 0), 3)\n",
    "            cv2.putText(img, cls_name, (x1, max(y1 - 10, 20)), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)\n",
    "            \n",
    "    plt.figure(figsize=(10, 8))\n",
    "    plt.imshow(img)\n",
    "    plt.axis(\"off\")\n",
    "    plt.show()\n",
    "\n",
    "# Check validation split first item\n",
    "val_img_dir = dataset_dir / \"valid\" / \"images\"\n",
    "val_lbl_dir = dataset_dir / \"valid\" / \"labels\"\n",
    "if val_img_dir.exists() and data_yaml_path.exists():\n",
    "    val_images = sorted(list(val_img_dir.glob(\"*\")))\n",
    "    class_names = data_yaml.get(\"names\", [\"string_hoppers\"])\n",
    "    if val_images:\n",
    "        sample_img = val_images[0]\n",
    "        sample_lbl = val_lbl_dir / f\"{sample_img.stem}.txt\"\n",
    "        draw_bbox_and_show(sample_img, sample_lbl, class_names)\n",
    "    else:\n",
    "        print(\"No images found in validation images folder.\")\n",
    "else:\n",
    "    print(\"Cannot visualize. Please ensure dataset is in place.\")"
   ]
  }
 ],
